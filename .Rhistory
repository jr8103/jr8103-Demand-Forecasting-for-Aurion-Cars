output$product_image <- renderImage({
req(input$variant != "All")
image_name <- switch(
input$model,
"Model 1" = "model1.jpg",
"Model 2" = "model2.jpg",
"Model 3" = "model3.jpg",
"Model 4" = "model4.png"
)
list(
src = image_name,
width = 350
)
}, deleteFile = FALSE)
forecast_data <- reactive({
df <- data
if(input$modelf != "All"){
df <- df %>%
filter(Model_Name == input$modelf)
}
if(input$variantf != "All"){
df <- df %>%
filter(Variant_Code == input$variantf)
}
df %>%
group_by(Year, Month) %>%
summarise(
Sales = sum(Monthly_Sales),
.groups = "drop"
)
})
forecast_result <- eventReactive(input$submit, {
df <- forecast_data()
ts_data <- ts(
df$Sales,
start = c(min(df$Year), min(df$Month)),
frequency = 12
)
train_size <- floor(0.9 * length(ts_data))
train <- ts_data[1:train_size]
test <- ts_data[(train_size + 1):length(ts_data)]
#-------------------------
# ETS MODEL
#-------------------------
clean_train <- tsclean(train)
ets_model <- ets(
clean_train,
biasadj = TRUE
)
ets_pred <- forecast(
ets_model,
h = length(test)
)
ets_mape <- mean(
abs((test - ets_pred$mean) / test)
) * 100
ets_accuracy <- 100 - ets_mape
#-------------------------
# ARIMA MODEL
#-------------------------
arima_model <- auto.arima(
train,
seasonal = TRUE
)
arima_pred <- forecast(
arima_model,
h = length(test)
)
arima_mape <- mean(
abs((test - arima_pred$mean) / test)
) * 100
arima_accuracy <- 100 - arima_mape
#-------------------------
# SELECT BEST MODEL
#-------------------------
if (ets_accuracy >= arima_accuracy) {
final_model <- ets(
tsclean(ts_data),
biasadj = TRUE
)
selected_model <- "ETS"
best_accuracy <- ets_accuracy
} else {
final_model <- auto.arima(
ts_data,
seasonal = TRUE
)
selected_model <- "ARIMA"
best_accuracy <- arima_accuracy
}
future_forecast <- forecast(
final_model,
h = 12
)
rmse <- sqrt(
mean(
(test - forecast(final_model, h = length(test))$mean)^2
)
)
list(
model = selected_model,
forecast = future_forecast,
rmse = rmse,
accuracy = best_accuracy
)
})
output$model_used <- renderText({
req(forecast_result())
paste(
"Selected Model:",
forecast_result()$model
)
})
output$forecast_plot <- renderPlot({
req(forecast_result())
par(
bg = "black",      # background
fg = "white",      # axis lines and text
col.axis = "white",
col.lab = "white",
col.main = "white"
)
plot(
forecast_result()$forecast,
main = paste(
"Demand Forecast for",
input$modelf,
"- 2026"
),
xlab = "Year",
ylab = "Demand",
col = c("#FFB400"),
shadecols = c("gray50", "gray80"),
lwd = 3
)
})
output$forecast_table <- renderTable({
req(forecast_result())
fc <- forecast_result()$forecast
data.frame(
Month = month.abb,
Predicted_Demand =
round(fc$mean,0)
)
})
output$rmse <- renderText({
req(forecast_result())
paste(
"Root Mean Square Error (RMSE):",
round(
forecast_result()$rmse,
2
),
"units"
)
})
output$model_accuracy <- renderText({
req(forecast_result())
paste(
"Model Accuracy:",
round(forecast_result()$accuracy,2),
"%"
)
})
}
