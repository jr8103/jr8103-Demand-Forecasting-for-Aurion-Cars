if(input$model == "All"){
temp <- data %>%
group_by(Model_Name) %>%
summarise(Sales = sum(Monthly_Sales))
temp$Model_Name[which.max(temp$Sales)]
} else if(input$variant == "All"){
temp <- data %>%
filter(Model_Name == input$model) %>%
group_by(Variant_Code) %>%
summarise(Sales = sum(Monthly_Sales))
temp$Variant_Code[which.max(temp$Sales)]
} else{
